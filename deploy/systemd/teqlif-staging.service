[Unit]
Description=Teqlif FastAPI Backend (Staging)
After=network.target postgresql.service redis.service
PartOf=teqlif.service

[Service]
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/var/www/teqlif.com/backend/.env.staging
ExecStartPre=/var/www/teqlif.com/venv/bin/python -m alembic upgrade head
ExecStartPre=/var/www/teqlif.com/venv/bin/python /var/www/teqlif.com/backend/scripts/sync_main.py
ExecStart=/var/www/teqlif.com/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 2 --loop uvloop --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
