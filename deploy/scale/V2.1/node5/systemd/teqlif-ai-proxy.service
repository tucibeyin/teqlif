[Unit]
Description=teqlif AI Proxy Secondary (node5)
After=network.target wg-quick@wg0.service

[Service]
Type=simple
User=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.ai-proxy
ExecStart=/var/www/teqlif.com/.venv/bin/uvicorn app.ai_proxy_main:app \
    --host 0.0.0.0 \
    --port 8001 \
    --workers 2 \
    --log-level info
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
