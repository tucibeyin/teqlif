[Unit]
Description=teqlif ARQ Worker Video Staging
After=teqlif-staging.service
PartOf=teqlif-staging.service
BindsTo=teqlif-staging.service

[Service]
Type=simple
User=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.staging
ExecStart=/var/www/teqlif.com/.venv/bin/python -m arq app.worker.WorkerSettingsVideo
Restart=on-failure
RestartSec=60
LimitNOFILE=65535
CPUQuota=50%
MemoryHigh=2G
MemoryMax=3G
OOMPolicy=kill
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
