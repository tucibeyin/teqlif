[Unit]
Description=teqlif Edge Metrics Agent (node5 — Staging Redis)
After=network.target teqlif-ai-proxy.service teqlif-redis-staging.service
Wants=teqlif-ai-proxy.service
PartOf=teqlif-staging.service

[Service]
Type=simple
User=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.metrics-agent-staging
ExecStart=/var/www/teqlif.com/.venv/bin/python scripts/edge_metrics_agent.py
Restart=always
RestartSec=10
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
