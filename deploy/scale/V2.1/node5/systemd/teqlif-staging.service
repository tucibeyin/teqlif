[Unit]
Description=teqlif FastAPI Staging
After=network.target

[Service]
Type=simple
User=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.staging
ExecStartPre=/var/www/teqlif.com/.venv/bin/alembic upgrade head
ExecStartPre=/var/www/teqlif.com/.venv/bin/python scripts/sync_main.py
ExecStart=/var/www/teqlif.com/.venv/bin/uvicorn main:app \
    --host 10.10.0.5 \
    --port 8000 \
    --workers 2 \
    --log-level warning \
    --access-log
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
