[Unit]
Description=teqlif ARQ Worker Critical Staging
After=teqlif-staging.service
BindsTo=teqlif-staging.service

[Service]
Type=simple
User=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.staging
ExecStart=/var/www/teqlif.com/.venv/bin/python -m arq app.worker.WorkerSettingsCritical
Restart=always
RestartSec=5
LimitNOFILE=65535
CPUQuota=50%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
