# node5 — Staging Edge Metrics Agent
# /project/teqlif/config/.env.metrics-agent-staging — chmod 600
#
# Bu agent STAGING Redis'e (127.0.0.1:6379/0) yazar.
# Staging backend böylece edge:metrics:node5 anahtarını kendi Redis'inden okuyabilir.

CORE_REDIS_URL=redis://:<staging_redis_pass>@127.0.0.1:6379/0
EDGE_NODE_ID=node5
EDGE_NODE_TYPE=ai,staging
NODE_SERVICES=ai_proxy
EDGE_AI_PROXY_URL=http://127.0.0.1:8001
EDGE_AI_PROXY_PRIORITY=10
EDGE_NODE_REGION=eu-west
DISK_PATH=/
EDGE_METRICS_INTERVAL_SEC=10

# Telegram Alerting
TELEGRAM_BOT_TOKEN=<telegram_bot_token>
TELEGRAM_CHAT_ID=<telegram_chat_id>
