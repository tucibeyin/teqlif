# node5 — Staging Environment
# /project/teqlif/config/.env.staging — chmod 600

# === Veritabanı (node5 lokal staging) ===
DATABASE_URL=postgresql+asyncpg://teqlif:<staging_pg_pass>@127.0.0.1:5432/teqlif_staging
REDIS_URL=redis://:<staging_redis_pass>@127.0.0.1:6379/0
USE_PGBOUNCER=False

# === MinIO (node5 lokal staging) ===
UPLOADS_HOST=https://staging.uploads.teqlif.com
MINIO_BUCKET=teqlif-staging
MINIO_DM_BUCKET=teqlif-dm-staging
MINIO_ENDPOINT=http://127.0.0.1:9100
MINIO_ENDPOINT_DM=http://127.0.0.1:9100
MINIO_ACCESS_KEY=<minio_staging_root_user>
MINIO_SECRET_KEY=<minio_staging_root_password>
MINIO_SECURE=False
MINIO_REGION=us-east-1

# === ClickHouse (node2 shared, staging DB) ===
CLICKHOUSE_HOST=10.10.0.2
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=teqlif_analytics_staging
CLICKHOUSE_USER=teqlif
CLICKHOUSE_PASSWORD=<teqlif_ch_password>

# === AI Proxy (node5 lokal secondary) ===
AI_PROXY_URL=http://127.0.0.1:8001
AI_PROXY_FALLBACK_URL=http://10.10.0.6:8001
AI_PROXY_INTERNAL_TOKEN=<ai_proxy_internal_token>

# === JWT / Auth ===
SECRET_KEY=<staging_secret_key>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# === LiveKit (staging) ===
LIVEKIT_API_KEY=<livekit_staging_api_key>
LIVEKIT_API_SECRET=<livekit_staging_api_secret>

# === Firebase ===
FIREBASE_SERVICE_ACCOUNT=/project/teqlif/config/firebase-service-account.json

# === E-posta (Stalwart SMTP) ===
MAIL_SENDER_NAME=teqlif [staging]
MAIL_NOREPLY_TEQLIF_PASSWORD=<mail_noreply_teqlif_password>

# === Apple Push (APNS — sandbox) ===
APNS_KEY_PATH=/project/teqlif/config/AuthKey_<apns_key_id>.p8
APNS_KEY_ID=<apns_key_id>
APNS_TEAM_ID=<apns_team_id>
IOS_BUNDLE_ID=teqlif
APNS_USE_SANDBOX=True

# === Google OAuth ===
GOOGLE_CLIENT_ID=<google_client_id>

# === Sentry ===
SENTRY_BACKEND_DSN=<sentry_backend_dsn_staging>

# === Captcha ===
CAPTCHA_ENABLED=False
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=<captcha_secret_key>

# === Admin ===
ADMIN_EMAIL=<admin_email>
ADMIN_PASSWORD_HASH=<admin_password_hash>

# === Telegram ===
TELEGRAM_BOT_TOKEN=<telegram_bot_token>
TELEGRAM_CHAT_ID=<telegram_chat_id>

# === Genel ===
SITE_URL=https://staging.teqlif.com
DEBUG=True
WEB_APP_ENABLED=False
EDGE_NODE_ID=node5
DATA_DISK_PATH=/
