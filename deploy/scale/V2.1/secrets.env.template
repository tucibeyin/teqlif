# teqlif V2.1 — Secrets Dosyası
# ─────────────────────────────────────────────────────────────────────────────
# KULLANIM:
#   cp secrets.env.template secrets.env
#   chmod 600 secrets.env
#   Aşağıdaki değerleri doldur (bölüm açıklamalarına bak)
#   secrets.env .gitignore'da — repoya GİRMEZ
#
# BOOTSTRAP:
#   scp secrets.env tucibeyin@<node-ip>:/tmp/teqlif-secrets.env
#   ssh tucibeyin@<node-ip> "SECRETS_FILE=/tmp/teqlif-secrets.env bash bootstrap_nodeX.sh"
#   Bootstrap bittikten sonra /tmp/teqlif-secrets.env otomatik silinir (shred)
#
# GÜNCELLEME: secrets.env.template Claude tarafından güncellenir (yeni servis
#   eklenince). secrets.env dosyanda eksik satır varsa template'ten ekle.
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# BÖLÜM 1 — Otomatik Üretilebilir (openssl rand)
# Her biri için: openssl rand -hex 32  (kısa olanlar için: openssl rand -hex 16)
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL (node1) ────────────────────────────────────────────────────────
# Ana uygulama DB şifresi — node1 PostgreSQL
teqlif_db_password=

# Replikasyon kullanıcısı şifresi — pg_receivewal (node2) bu şifreyle bağlanır
# CREATE ROLE teqlif_repl WITH REPLICATION LOGIN PASSWORD '...';
teqlif_repl_password=

# ── Redis (node1) ─────────────────────────────────────────────────────────────
# redis-core :6379 — uygulama cache, ARQ, LiveKit koordinasyonu
core_redis_pass=

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Prod JWT imzası (node1 FastAPI)
secret_key=

# Staging JWT imzası (node5, prod'dan FARKLI olmalı)
staging_secret_key=

# ── Staging Veritabanı + Cache (node5) ────────────────────────────────────────
# node5 lokal PostgreSQL staging şifresi
staging_pg_pass=

# node5 lokal Redis staging şifresi
staging_redis_pass=

# ── MinIO (node1) ─────────────────────────────────────────────────────────────
# openssl rand -hex 16  (kısa kullanıcı adı için)
minio_root_user=

# openssl rand -hex 32
minio_root_password=

# ── MinIO Staging (node5) ─────────────────────────────────────────────────────
minio_staging_root_user=

minio_staging_root_password=

# ── LiveKit Staging (node5) ───────────────────────────────────────────────────
livekit_staging_api_key=

livekit_staging_api_secret=

# ── Stalwart Mail Server (node2) ─────────────────────────────────────────────
# Web admin API şifresi (node2:/project/mail/config/.env.mail → STALWART_ADMIN_SECRET)
# openssl rand -base64 32
stalwart_admin_secret=

# admin@teqlif.com IMAP/SMTP şifresi
# openssl rand -base64 24
mail_admin_teqlif_password=

# noreply@teqlif.com SMTP gönderim şifresi (app tarafından kullanılır)
# openssl rand -base64 24
mail_noreply_teqlif_password=

# info@teqlif.com IMAP/SMTP şifresi
# openssl rand -base64 24
mail_info_teqlif_password=

# support@teqlif.com IMAP/SMTP şifresi
# openssl rand -base64 24
mail_support_teqlif_password=

# ── ClickHouse (node2) ────────────────────────────────────────────────────────
# Teqlif ClickHouse kullanıcı şifresi
teqlif_ch_password=

# ClickHouse XML SHA256 hash (teqlif_ch_password'dan türet):
# echo -n "<teqlif_ch_password değeri>" | shasum -a 256 | awk '{print $1}'
teqlif_password_sha256=

# ClickHouse default kullanıcı şifresi (ayrı, openssl rand -hex 32)
clickhouse_default_password=

# echo -n "<clickhouse_default_password değeri>" | shasum -a 256 | awk '{print $1}'
default_password_sha256=

# ── AI Proxy (node5 + node6) ──────────────────────────────────────────────────
# node1 → node6/5 çağrılarında iç doğrulama token'ı
ai_proxy_internal_token=

# ── Public IP'ler (gizli değil, WireGuard endpoint'leri için gerekli) ─────────
# node1 public IP (OVH Gravelines, 193.70.46.74 — bare metal, genellikle sabit)
node1_public_ip=193.70.46.74

# node2 public IP (OVH Saarbrücken, 135.125.223.43 — bare metal, genellikle sabit)
node2_public_ip=135.125.223.43

# node3 public IP (OVH Frankfurt VPS)
node3_public_ip=51.75.74.124

# node4 public IP (OVH Frankfurt VPS)
node4_public_ip=135.125.175.223

# node5 public IP (ZAP Münster VPS)
node5_public_ip=45.146.252.165

# node6 public IP (ZAP Virginia VPS)
node6_public_ip=5.249.165.10


# ══════════════════════════════════════════════════════════════════════════════
# BÖLÜM 2 — Harici Servis Credential'ları (Panelden Al)
# ══════════════════════════════════════════════════════════════════════════════

# ── LiveKit Cloud (node3/4 prod streaming) ────────────────────────────────────
# https://cloud.livekit.io → Project → API Keys
livekit_api_key=

livekit_api_secret=

# ── Brevo (e-posta gönderimi) — AŞAMA 2'DE KALDIRILACAK ─────────────────────
# App Stalwart SMTP'ye geçince bu key artık kullanılmayacak.
# https://app.brevo.com → SMTP & API → API Keys
brevo_api_key=

# ── Apple Push Notification (APNS) ───────────────────────────────────────────
# https://developer.apple.com → Certificates → Keys → AuthKey_*.p8
apns_key_id=

apns_team_id=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
google_client_id=

# ── Groq (AI proxy fallback) ──────────────────────────────────────────────────
# https://console.groq.com → API Keys
groq_api_key=

# ── Google Gemini (AI proxy primary, node6 US) ────────────────────────────────
# https://aistudio.google.com → Get API key
gemini_api_key=

# ── Sentry ────────────────────────────────────────────────────────────────────
# https://sentry.io → Project → Settings → Client Keys → DSN
sentry_backend_dsn=

sentry_backend_dsn_staging=

# ── Telegram (Alertmanager + Guardian bildirimleri) ───────────────────────────
# @BotFather → /newbot → token
telegram_bot_token=

# @userinfobot ile öğren (sayı, - ile başlayabilir)
telegram_chat_id=

# Alerts kanalı (ops kanalından farklıysa, aynıysa yukarıdaki değeri tekrar gir)
telegram_chat_id_alerts=

# ── Cloudflare Turnstile (CAPTCHA) ────────────────────────────────────────────
# https://dash.cloudflare.com → Turnstile → Site → Secret Key
captcha_secret_key=

# ── Admin Kullanıcısı ─────────────────────────────────────────────────────────
admin_email=

# bcrypt hash: python3 -c "import bcrypt; print(bcrypt.hashpw(b'SIFRE', bcrypt.gensalt()).decode())"
admin_password_hash=


