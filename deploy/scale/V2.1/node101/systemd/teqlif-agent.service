[Unit]
Description=teqlif Gossip Agent (node101 — offsite-backup)
After=network-online.target restic-rest-server.service
Wants=network-online.target
PartOf=restic-rest-server.service
BindsTo=restic-rest-server.service

[Service]
Type=simple
User=teqlif-agent
Group=teqlif-agent
WorkingDirectory=/opt/teqlif-agent
EnvironmentFile=-/etc/teqlif-agent/env
ExecStart=/opt/teqlif-agent/venv/bin/python agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/teqlif-agent /var/log/teqlif-agent
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
