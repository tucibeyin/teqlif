# /etc/teqlif-offsite/restic.env — node101 yerel restic işlemleri (prune, verify)
# Sahiplik: root:teqlif-backup  İzinler: 640
# Bu dosya HTTP kullanmaz — doğrudan /mnt/data/teqlif/ üzerinde çalışır (--private-repos → HTTP user = teqlif).

# Restic repo yolu — node101 yerel HDD, proje bazlı dizin
# --private-repos: HTTP user "teqlif" → /mnt/data/teqlif/
RESTIC_REPOSITORY=/mnt/data/teqlif

# AES-256 şifreleme parolası (gizli — secrets.env'den aktarılır)
RESTIC_PASSWORD=<restic_aes_password>

# Bellek optimizasyonu (83 IOPS fdatasync kısıtı için pack boyutu sabit)
GOGC=20
GOMEMLIMIT=1536MiB
TMPDIR=/mnt/data/tmp
RESTIC_CACHE_DIR=/mnt/data/cache/restic
