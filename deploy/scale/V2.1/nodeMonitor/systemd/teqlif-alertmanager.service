[Unit]
Description=Alertmanager — teqlif
After=network.target

[Service]
User=tucibeyin
ExecStart=/usr/local/bin/alertmanager \
  --config.file=/var/www/teqlif.com/deploy/scale/V2.1/nodeMonitor/config/teqlif/alertmanager.yml \
  --storage.path=/opt/monitor/teqlif/alertmanager/data \
  --web.listen-address=127.0.0.1:9093
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
