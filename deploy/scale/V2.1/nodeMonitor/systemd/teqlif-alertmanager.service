[Unit]
Description=Alertmanager — teqlif
After=network.target

[Service]
User=tucibeyin
ExecStart=/usr/local/bin/alertmanager \
  --config.file=/project/teqlif/config/alertmanager.yml \
  --storage.path=/opt/monitor/teqlif/alertmanager/data \
  --web.listen-address=127.0.0.1:9093 \
  --cluster.listen-address=10.10.0.99:9094
Restart=always
RestartSec=5
MemoryMax=100M

[Install]
WantedBy=multi-user.target
