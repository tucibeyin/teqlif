#!/bin/bash
# MIGRATION SHIM — node101 bootstrap tarafından yanlış kurulmuş eski kopya
#
# Gerçek script: deploy/scale/V2.1/scripts/teqlif-restart.sh
# bootstrap_node101.sh artık doğru scripti kuruyor (install_teqlif_restart_node101).
# Bu dosya, node101'de eski kopyanın yerini alana kadar yönlendirme görevi görür.
#
# Bu dosyayı düzenleme — değişiklikler scripts/teqlif-restart.sh'a yapılmalı.

REAL_SCRIPT="$(dirname "$(readlink -f "$0")")/../../scripts/teqlif-restart.sh"
if [ -x "${REAL_SCRIPT}" ]; then
    exec "${REAL_SCRIPT}" "$@"
fi

# Repo relative bulunamazsa kurulu gerçek konumu dene
exec /usr/local/sbin/teqlif-restart "$@"
