// teqlif-agent servis restart izinleri
//
// teqlif-agent.service'de NoNewPrivileges=true olduğu için sudo çalışmaz.
// Bu polkit kuralı, teqlif-agent kullanıcısının busctl aracılığıyla
// systemd üzerinden yalnızca onaylı servisleri yeniden başlatabilmesini sağlar.
//
// Dağıtım: teqlif-restart.sh → /etc/polkit-1/rules.d/50-teqlif-agent.rules
// (teqlif-restart.sh agent_sync() bölümünde otomatik güncellenir)

polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") return;
    if (subject.user !== "teqlif-agent") return;

    var allowed = [
        "teqlif.service",
        "teqlif-worker.service",
        "teqlif-worker-critical.service",
        "teqlif-worker-video.service",
        "teqlif-ai-proxy.service",
        "teqlif-livekit.service",
        "teqlif-agent.service",
        "teqlif-staging.service",
        "teqlif-worker-staging.service",
        "teqlif-worker-critical-staging.service",
    ];

    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";

    if ((verb === "restart" || verb === "start") && allowed.indexOf(unit) >= 0) {
        return polkit.Result.YES;
    }
});
