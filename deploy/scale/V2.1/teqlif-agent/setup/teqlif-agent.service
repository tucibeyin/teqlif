[Unit]
Description=teqlif Platform Control Plane Agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=teqlif-agent
Group=teqlif-agent
WorkingDirectory=/opt/teqlif-agent
EnvironmentFile=-/etc/teqlif-agent/env
ExecStart=/opt/teqlif-agent/venv/bin/python agent.py
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=10s
StandardOutput=append:/var/log/teqlif-agent/agent.log
StandardError=append:/var/log/teqlif-agent/agent.log
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/teqlif-agent /var/log/teqlif-agent /var/recordings
PrivateTmp=true

[Install]
WantedBy=multi-user.target
