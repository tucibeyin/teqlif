# node6 (US East) — Edge Metrics Agent
# /project/teqlif/config/.env.metrics-agent — chmod 600
# NOT: teqlif-ai-proxy node6'da devre dışı bırakıldı (node5'e taşındı)

CORE_REDIS_URL=redis://:<core_redis_pass>@10.10.0.1:6379/0
EDGE_NODE_ID=node6
EDGE_NODE_TYPE=general
NODE_SERVICES=
EDGE_NODE_REGION=us-east
DISK_PATH=/
EDGE_METRICS_INTERVAL_SEC=10

# Telegram Alerting
TELEGRAM_BOT_TOKEN=<telegram_bot_token>
TELEGRAM_CHAT_ID=<telegram_chat_id>
