<clickhouse>
    <listen_host>127.0.0.1</listen_host>
    <listen_host>10.10.0.2</listen_host>

    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>

    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
    <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>
    <max_connections>128</max_connections>

    <!-- Arka plan merge/TTL thread'lerini HDD'ye göre kısıtla -->
    <!-- pool_size=4, ratio=2 → effective_pool=8; mutation threshold 3 < 8 ✓ -->
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
    <merge_tree>
        <number_of_free_entries_in_pool_to_execute_mutation>3</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>7</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>

    <!-- BACKUP DATABASE ... TO Disk('backups', ...) için -->
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/project/teqlif/backups/clickhouse/</path>
            </backups>
        </disks>
    </storage_configuration>

    <logger>
        <level>warning</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>7</count>
    </logger>
</clickhouse>
