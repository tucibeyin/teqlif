<clickhouse>
    <!-- Prometheus scrape endpoint — port 9363 (nodeMonitor → scrape via WireGuard) -->
    <!-- Kurulum: cp prometheus.xml /etc/clickhouse-server/config.d/ && systemctl reload clickhouse-server -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <status_info>true</status_info>
    </prometheus>
</clickhouse>
