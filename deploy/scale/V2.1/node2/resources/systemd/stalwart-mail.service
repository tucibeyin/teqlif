[Unit]
Description=Stalwart Mail Server (SMTP + IMAP)
Documentation=https://stalw.art/docs
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=stalwart
Group=stalwart

EnvironmentFile=/project/teqlif/config/.env.mail
ExecStart=/usr/local/bin/stalwart-mail --config /project/teqlif/config/stalwart/config.toml

# Port 25/443/465/587/993 bağlama yetkisi (root gerektirmez)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Güvenlik sertleştirme
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/project/teqlif/data/mail /project/teqlif/config/stalwart
ProtectHome=true

Restart=on-failure
RestartSec=5
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=stalwart-mail

[Install]
WantedBy=multi-user.target
