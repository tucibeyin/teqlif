# /project/teqlif/config/.env.mail
# Stalwart Mail Server secrets — sunucuda kalır, repoya girmez
# cp env.mail.template /project/teqlif/config/.env.mail && chmod 600 ...

# Mail sunucusunun FQDN (PTR kaydıyla eşleşmeli)
MAIL_HOSTNAME=mail.teqlif.com

# Let's Encrypt bildirim adresi (sertifika süresi dolmadan uyarı gelir)
MAIL_ACME_CONTACT=mailto:admin@teqlif.com

# Stalwart web admin şifresi
# Üretmek için: openssl rand -base64 32
STALWART_ADMIN_SECRET=BURAYA_GUCLU_SIFRE

# CLI erişimi için (stalwart-cli --credentials kullanımı)
# STALWART_URL=http://10.10.0.2:8080
# STALWART_CREDENTIALS=admin:BURAYA_GUCLU_SIFRE
