[Unit]
Description=teqlif FastAPI Disaster Recovery (node2 — aktif sadece node1 çöküşünde)
After=network.target postgresql.service
Wants=nginx.service

[Service]
Type=simple
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.dr
ExecStart=/var/www/teqlif.com/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 4 \
    --log-level warning
Restart=on-failure
RestartSec=10
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
