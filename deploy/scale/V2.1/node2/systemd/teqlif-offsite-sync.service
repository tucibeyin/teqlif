[Unit]
Description=teqlif Offsite Sync — daily-full restic → node101
After=teqlif-pg-dump.service teqlif-minio-backup.service
OnFailure=teqlif-backup-failed@%n.service

[Service]
Type=oneshot
User=tucibeyin
EnvironmentFile=/project/teqlif/config/.env.backup
IOSchedulingClass=idle
Nice=19
ExecStart=/var/www/teqlif.com/deploy/scale/V2.1/node2/resources/scripts/offsite_sync.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=7200
