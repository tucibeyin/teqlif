[Unit]
Description=teqlif PostgreSQL Base Backup (node1 → node2, haftalık)
After=network.target wg-quick@wg0.service
Wants=wg-quick@wg0.service

[Service]
Type=oneshot
User=tucibeyin
EnvironmentFile=/project/teqlif/config/.env.backup
ExecStart=/var/www/teqlif.com/deploy/scale/V2.1/node2/resources/scripts/pg_basebackup.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800
