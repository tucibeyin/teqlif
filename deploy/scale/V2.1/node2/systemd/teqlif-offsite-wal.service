[Unit]
Description=teqlif Offsite WAL Sync — saatlik restic → node101
OnFailure=teqlif-backup-failed@%n.service

[Service]
Type=oneshot
User=tucibeyin
EnvironmentFile=/project/teqlif/config/.env.backup
IOSchedulingClass=idle
Nice=19
ExecStart=/var/www/teqlif.com/deploy/scale/V2.1/node2/resources/scripts/offsite_wal_sync.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800
