[Unit]
Description=teqlif Financial WORM Backup — TTK/MASAK aylık finansal arşiv (financial-worm tag)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
PartOf=teqlif-financial-worm.timer
OnFailure=teqlif-backup-failed@%n.service

[Service]
Type=oneshot
User=tucibeyin
EnvironmentFile=/project/teqlif/config/.env.backup
IOSchedulingClass=idle
Nice=19
TimeoutStartSec=7200
ExecStart=/var/www/teqlif.com/deploy/scale/V2.1/node2/resources/scripts/financial_worm_backup.sh
StandardOutput=journal
StandardError=journal
