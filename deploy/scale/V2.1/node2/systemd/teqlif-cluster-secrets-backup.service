[Unit]
Description=teqlif Cluster Secrets Backup — TLS/env tüm node'lardan node2'ye
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
PartOf=teqlif-cluster-secrets-backup.timer

[Service]
Type=oneshot
User=tucibeyin
EnvironmentFile=/project/teqlif/config/.env.backup
IOSchedulingClass=idle
Nice=19
ExecStart=/var/www/teqlif.com/deploy/scale/V2.1/node2/resources/scripts/cluster_secrets_backup.sh
StandardOutput=journal
StandardError=journal

OnFailure=teqlif-backup-failed@%n.service
