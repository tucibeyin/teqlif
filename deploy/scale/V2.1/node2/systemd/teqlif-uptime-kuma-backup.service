[Unit]
Description=teqlif Uptime Kuma SQLite Backup (nodeMonitor → node2)
After=network.target wg-quick@wg0.service
OnFailure=teqlif-backup-failed@%n.service

[Service]
Type=oneshot
User=tucibeyin
ExecStart=/var/www/teqlif.com/deploy/scale/V2.1/node2/resources/scripts/uptime_kuma_backup.sh
StandardOutput=journal
StandardError=journal
