# node1 (Core) — Production Environment
# /project/teqlif/config/.env.production — chmod 600

# === Veritabanı ===
DATABASE_URL=postgresql+asyncpg://teqlif:<teqlif_db_password>@127.0.0.1:6432/teqlif
REDIS_URL=redis://:<core_redis_pass>@127.0.0.1:6379/0
USE_PGBOUNCER=True

# === MinIO (node1 lokal) ===
UPLOADS_HOST=https://uploads.teqlif.com
MINIO_BUCKET=teqlif
MINIO_DM_BUCKET=teqlif-dm
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ENDPOINT_DM=http://127.0.0.1:9000
MINIO_ACCESS_KEY=<minio_root_user>
MINIO_SECRET_KEY=<minio_root_password>
MINIO_SECURE=False
MINIO_REGION=us-east-1

# === ClickHouse (node2) ===
CLICKHOUSE_HOST=10.10.0.2
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=teqlif_analytics
CLICKHOUSE_USER=teqlif
CLICKHOUSE_PASSWORD=<teqlif_ch_password>

# === AI Proxy ===
AI_PROXY_URL=http://10.10.0.6:8001
AI_PROXY_FALLBACK_URL=http://10.10.0.5:8001
AI_PROXY_INTERNAL_TOKEN=<ai_proxy_internal_token>

# === JWT / Auth ===
SECRET_KEY=<secret_key>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# === LiveKit ===
LIVEKIT_API_KEY=<livekit_api_key>
LIVEKIT_API_SECRET=<livekit_api_secret>

# === Firebase (FCM Push) ===
FIREBASE_SERVICE_ACCOUNT=/project/teqlif/config/firebase-service-account.json

# === E-posta (Brevo) ===
BREVO_API_KEY=<brevo_api_key>
BREVO_SENDER_EMAIL=noreply@teqlif.com
BREVO_SENDER_NAME=teqlif

# === Apple Push (APNS) ===
APNS_KEY_PATH=/project/teqlif/config/AuthKey_<apns_key_id>.p8
APNS_KEY_ID=<apns_key_id>
APNS_TEAM_ID=<apns_team_id>
IOS_BUNDLE_ID=teqlif
APNS_USE_SANDBOX=False

# === Google OAuth ===
GOOGLE_CLIENT_ID=<google_client_id>

# === Sentry ===
SENTRY_BACKEND_DSN=<sentry_backend_dsn>

# === Captcha (Cloudflare Turnstile) ===
CAPTCHA_ENABLED=True
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=<captcha_secret_key>

# === Admin ===
ADMIN_EMAIL=<admin_email>
ADMIN_PASSWORD_HASH=<admin_password_hash>

# === Telegram ===
TELEGRAM_BOT_TOKEN=<telegram_bot_token>
TELEGRAM_CHAT_ID=<telegram_chat_id>

# === Genel ===
SITE_URL=https://www.teqlif.com
DEBUG=False
WEB_APP_ENABLED=False
EDGE_NODE_ID=node1
EDGE_NODE_TYPE=api,storage
NODE_SERVICES=postgres,minio,redis
CORE_REDIS_URL=redis://:<core_redis_pass>@127.0.0.1:6379/0
EDGE_MINIO_URL=http://10.10.0.1:9000
EDGE_NODE_REGION=eu-west
EDGE_LIVEKIT_URLS=wss://live2.teqlif.com,wss://live1.teqlif.com
DATA_DISK_PATH=/
