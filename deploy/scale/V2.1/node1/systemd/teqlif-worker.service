[Unit]
Description=teqlif ARQ Worker
After=teqlif.service
BindsTo=teqlif.service

[Service]
Type=simple
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.production
ExecStart=/var/www/teqlif.com/.venv/bin/python -m arq app.worker.WorkerSettings
Restart=always
RestartSec=30
LimitNOFILE=65535
MemoryHigh=4G
MemoryMax=5G
OOMPolicy=kill
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
