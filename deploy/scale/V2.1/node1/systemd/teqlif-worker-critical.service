[Unit]
Description=teqlif ARQ Worker Critical
After=teqlif.service
BindsTo=teqlif.service

[Service]
Type=simple
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.production
ExecStart=/var/www/teqlif.com/.venv/bin/python -m arq app.worker.CriticalWorkerSettings
Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
