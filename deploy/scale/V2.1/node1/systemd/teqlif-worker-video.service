[Unit]
Description=teqlif ARQ Worker Video
After=teqlif.service
PartOf=teqlif.service
BindsTo=teqlif.service

[Service]
Type=simple
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.production
ExecStart=/var/www/teqlif.com/.venv/bin/python -m arq app.worker.WorkerSettingsVideo
Restart=on-failure
RestartSec=60
LimitNOFILE=65535
MemoryHigh=3G
MemoryMax=4G
OOMPolicy=kill
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
