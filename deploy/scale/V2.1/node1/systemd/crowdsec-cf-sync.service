[Unit]
Description=CrowdSec ban decisions → Cloudflare IP list sync
After=network-online.target crowdsec.service
# crowdsec dursa timer tetiklenmeye devam eder ama cscli başarısız döner → alarm

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/crowdsec-cf-sync.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crowdsec-cf-sync
TimeoutStartSec=30

# Uptime Kuma push monitor URL'si — boş bırakılırsa heartbeat atlanır.
# Uptime Kuma > New Monitor > Push > URL'yi kopyala, buraya yapıştır:
Environment="HEARTBEAT_URL="
