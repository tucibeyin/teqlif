[Unit]
Description=teqlif MinIO Object Storage
After=network.target
PartOf=teqlif.service

[Service]
Type=simple
User=tucibeyin
Group=tucibeyin
EnvironmentFile=/project/teqlif/config/.env.minio
ExecStart=/usr/local/bin/minio server /project/teqlif/data/minio/data \
    --address 0.0.0.0:9000 \
    --console-address 127.0.0.1:9001 \
    --json
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
