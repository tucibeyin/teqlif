[Unit]
Description=teqlif FastAPI Application
After=network.target postgresql.service teqlif-redis-core.service teqlif-minio.service
Requires=teqlif-redis-core.service teqlif-redis-orch.service teqlif-redis-guardian.service
Wants=teqlif-redis-core.service teqlif-redis-orch.service teqlif-redis-guardian.service teqlif-minio.service

[Service]
Type=simple
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.production
ExecStartPre=/var/www/teqlif.com/.venv/bin/alembic upgrade head
ExecStart=/var/www/teqlif.com/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 4 \
    --log-level info \
    --access-log \
    --use-colors
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
