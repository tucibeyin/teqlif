[Unit]
Description=teqlif FastAPI Application
After=network.target postgresql.service teqlif-redis-core.service teqlif-minio.service
Requires=teqlif-redis-core.service
Wants=teqlif-redis-core.service teqlif-minio.service

[Service]
Type=simple
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.production
ExecStart=/var/www/teqlif.com/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 8 \
    --proxy-headers \
    --forwarded-allow-ips="127.0.0.1" \
    --log-level warning
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
