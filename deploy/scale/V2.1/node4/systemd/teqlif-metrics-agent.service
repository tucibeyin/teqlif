[Unit]
Description=teqlif Edge Metrics Agent (node4 — Media/LiveKit)
After=network.target wg-quick@wg0.service teqlif-livekit.service
Wants=teqlif-livekit.service

[Service]
Type=simple
User=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/project/teqlif/config/.env.metrics-agent
ExecStart=/var/www/teqlif.com/.venv/bin/python scripts/edge_metrics_agent.py
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
