[Unit]
Description=Node Exporter — node5 metrikleri node3 Prometheus'a
After=network.target

[Service]
User=tucibeyin
Type=simple
ExecStart=/usr/local/bin/node_exporter --web.listen-address=10.10.0.5:9100
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
