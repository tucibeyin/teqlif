# node1 (Edge 1) — Production
# Edge node'lar sadece medya, depolama ve metrik ajanına ev sahipliği yapar.

# Edge Metrics Agent (Core'daki Orchestrator'a metrik göndermek için Core Redis URL'i)
CORE_REDIS_URL="redis://:YOUR_REDIS_PASSWORD@10.10.0.5:6379/1"
EDGE_NODE_ID=node1
EDGE_METRICS_INTERVAL_SEC=3

# LiveKit (Edge üzerinde çalışır, kendi lokal redis'ine bağlanır)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PORT=7880

# MinIO (Standalone İzole - %80 Disk Kotası ile)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_VOLUMES="/var/lib/minio"
MINIO_SERVER_URL="http://10.10.0.1:9010"
MINIO_BROWSER="off"
MINIO_STORAGE_QUOTA_PERCENT=80
