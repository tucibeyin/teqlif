# /etc/alertmanager/alertmanager.yml — node3
# Scale V1.3: alertmanager.service envsubst ile bu template'i render eder
# Değerler deploy/scale/resources/node3/.env.node3.production'dan okunur (--config.expand-env)

global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by: [alertname, node]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "${TELEGRAM_BOT_TOKEN}"
        chat_id: ${TELEGRAM_CHAT_ID}
        message: |
          {{ range .Alerts -}}
          {{ if eq .Status "firing" -}}
          🔴 *ALARM: {{ .Labels.alertname }}*
          📍 Node: `{{ .Labels.node }}`
          🔥 Durum: *DOWN / Aktif*
          📋 {{ .Annotations.summary }}
          {{ if .Annotations.description }}ℹ️ {{ .Annotations.description }}{{ end -}}
          🕐 Başladı: {{ .StartsAt.Format "02 Jan 15:04:05 UTC" }}
          {{ else -}}
          ✅ *ÇÖZÜLDÜ: {{ .Labels.alertname }}*
          📍 Node: `{{ .Labels.node }}`
          🟢 Durum: *UP / Normal*
          📋 {{ .Annotations.summary }}
          🕐 Çözüldü: {{ .EndsAt.Format "02 Jan 15:04:05 UTC" }}
          {{ end -}}
          {{ end }}
        parse_mode: Markdown
        send_resolved: true

inhibit_rules:
  - source_matchers: [severity="critical"]
    target_matchers: [severity="warning"]
    equal: [alertname, node]
