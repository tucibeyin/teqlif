# node2 (AI Proxy) — Production
# Kullanım: systemd EnvironmentFile olarak okunur (teqlif-ai-proxy.service)
# Doldurma: gerçek değerleri girdikten sonra chmod 600 uygula

# Kullanılmaz — node2 DB bağlantısı yapmaz; pydantic-settings zorunlu kıldığı için placeholder
DATABASE_URL=postgresql+asyncpg://placeholder:placeholder@localhost/placeholder
SECRET_KEY=placeholder_not_used_on_node2

# AI API anahtarları — gerçek değerleri gir
GROQ_API_KEY=
GEMINI_API_KEY=

# node1 tarafından doğrulama için kullanılır — openssl rand -hex 32
# Aynı değer node1/.env.production'daki NODE2_INTERNAL_TOKEN alanına da girilmeli
NODE2_INTERNAL_TOKEN=

# node1 Redis — WireGuard üzerinden erişilir
REDIS_URL=redis://10.10.0.1:6379

# Boş bırakılırsa Sentry devre dışı; node2 logları Loki'ye gider
SENTRY_BACKEND_DSN=
