# node3 — Production env (AI Proxy + Monitoring)
# Kullanım: teqlif-ai-proxy.service ve alertmanager.service tarafından okunur
# Doldurma: gerçek değerleri girdikten sonra chmod 600 uygula

# AI Proxy
GROQ_API_KEY=
GEMINI_API_KEY=
AI_PROXY_INTERNAL_TOKEN=
# node3 AI proxy, node1 Redis'e WireGuard üzerinden bağlanır
REDIS_URL=redis://10.10.0.1:6379

# Monitoring — Alertmanager (envsubst ile alertmanager.yml'e inject edilir)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
