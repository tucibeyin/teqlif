# node3 — Production env (AI Proxy + Monitoring)
# Kullanım: teqlif-ai-proxy.service ve alertmanager.service tarafından okunur
# Doldurma: gerçek değerleri girdikten sonra chmod 600 uygula

# App (pydantic Settings validation için gerekli — AI proxy DB kullanmaz)
# DATABASE_URL: .env.staging'den kopyala (postgresql+asyncpg://teqlif_staging:<şifre>@127.0.0.1:5432/teqlif_staging)
DATABASE_URL=
# SECRET_KEY: openssl rand -hex 32
SECRET_KEY=

# AI Proxy
GROQ_API_KEY=
GEMINI_API_KEY=
# AI_PROXY_INTERNAL_TOKEN: node1 ve node2 ile AYNI değer olmalı
AI_PROXY_INTERNAL_TOKEN=
# REDIS_URL: node1 redis.conf'tan al → sudo grep '^user default' /etc/redis/redis.conf
# Şifre: > ile ~* arasındaki değer. Format: redis://:<şifre>@10.10.0.1:6379
REDIS_URL=

# Monitoring — Alertmanager (envsubst ile alertmanager.yml'e inject edilir)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
