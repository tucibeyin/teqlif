# node3 — Staging env
# Kullanım: teqlif-staging.service, teqlif-worker-staging.service,
#           teqlif-worker-critical-staging.service tarafından okunur
# Doldurma: gerçek değerleri girdikten sonra chmod 600 uygula
# Not: node3 lokal PostgreSQL + Redis + MinIO kullanır

# Database (node3 lokal PostgreSQL — teqlif_staging DB)
DATABASE_URL=

# Redis (node3 lokal Redis — db=0, sadece staging)
REDIS_URL=redis://localhost:6379

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

UPLOAD_DIR=

# E-posta (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# LiveKit — prod LiveKit (node1) kullanılır; staging için ayrı LiveKit yok
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Firebase (FCM push)
FIREBASE_SERVICE_ACCOUNT=

# Sentry
SENTRY_BACKEND_DSN=

# Google OAuth
GOOGLE_CLIENT_ID=

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Captcha
CAPTCHA_ENABLED=
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=

# DB bağlantı havuzu
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT=
DB_POOL_RECYCLE=

# Telegram bildirim
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MinIO — node3 lokal MinIO (staging bucket'ları)
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=teqlif-staging
MINIO_DM_BUCKET=teqlif-dm-staging
MINIO_DM_EXTERNAL_URL=https://uploads-staging.teqlif.com

# Apple Push (APNs)
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_CERT_PATH=
APNS_USE_SANDBOX=true
IOS_BUNDLE_ID=

# AI API anahtarları (staging da AI proxy kullanır)
GROQ_API_KEY=
GEMINI_API_KEY=

# Scale V1.3 — AI proxy zinciri
# Primary: node2 (10.10.0.3), Secondary: node3 kendisi (10.10.0.4)
NODE2_AI_PROXY_URL=http://10.10.0.3:8080
NODE3_AI_PROXY_URL=http://10.10.0.4:8080
AI_PROXY_INTERNAL_TOKEN=

# Site
SITE_URL=https://staging.teqlif.com

# Loglama — log dosyası prefix'i (backend/logs/{LOG_NODE}-app.log vb.)
LOG_NODE=staging
