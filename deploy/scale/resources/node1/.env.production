# node1 — Production
# Kullanım: systemd EnvironmentFile olarak okunur (teqlif.service, teqlif-worker*.service)
# Doldurma: gerçek değerleri girdikten sonra chmod 600 uygula

DATABASE_URL=
REDIS_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

UPLOAD_DIR=

# E-posta (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Firebase (FCM push)
# Dosyayı VPS'e kopyala: scp firebase-service-account.json node1:/var/www/teqlif.com/backend/firebase-service-account.json && chmod 640 ...
FIREBASE_SERVICE_ACCOUNT=/var/www/teqlif.com/backend/firebase-service-account.json

# Sentry
SENTRY_BACKEND_DSN=

# Google OAuth
GOOGLE_CLIENT_ID=

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Captcha
CAPTCHA_ENABLED=
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=

# DB bağlantı havuzu
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT=
DB_POOL_RECYCLE=

# Telegram bildirim
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=teqlif
MINIO_DM_BUCKET=teqlif-dm
MINIO_DM_EXTERNAL_URL=

# Apple Push (APNs)
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_CERT_PATH=
APNS_USE_SANDBOX=false
IOS_BUNDLE_ID=

# AI API anahtarları
GROQ_API_KEY=
GEMINI_API_KEY=

# Site
SITE_URL=

# Scale V1.3 — AI proxy zinciri + loglama
# AI_PROXY_INTERNAL_TOKEN → node1, node2, node3'te aynı değer (openssl rand -hex 32)
NODE2_AI_PROXY_URL=http://10.10.0.3:8080
NODE3_AI_PROXY_URL=http://10.10.0.4:8080
AI_PROXY_INTERNAL_TOKEN=

# Loglama — log dosyası prefix'i (backend/logs/{LOG_NODE}-app.log vb.)
LOG_NODE=node1
