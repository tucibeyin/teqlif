[Unit]
Description=Teqlif ARQ Critical Worker (Bulkhead — push notifications, outbid, loser cascade)
After=network.target postgresql.service redis.service teqlif.service
BindsTo=teqlif.service
PartOf=teqlif.service
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/var/www/teqlif.com/deploy/scale/resources/node1/.env.production
ExecStart=/var/www/teqlif.com/venv/bin/arq app.worker.WorkerSettingsCritical
Restart=always
RestartSec=3
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=600
OOMScoreAdj=100
CPUWeight=100
IOWeight=100
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/teqlif.com
BindReadOnlyPaths=/home/tucibeyin/.postgresql

[Install]
WantedBy=multi-user.target
