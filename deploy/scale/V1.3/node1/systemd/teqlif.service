[Unit]
Description=Teqlif FastAPI Backend
After=network.target postgresql.service redis.service
Wants=teqlif-worker.service teqlif-worker-critical.service
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
Environment=TEQLIF_ENV_FILE=/var/www/teqlif.com/deploy/scale/resources/node1/.env.production
EnvironmentFile=/var/www/teqlif.com/deploy/scale/resources/node1/.env.production
ExecStartPre=/var/www/teqlif.com/venv/bin/python -m alembic upgrade head
ExecStartPre=/var/www/teqlif.com/venv/bin/python /var/www/teqlif.com/backend/scripts/sync_main.py
ExecStart=/var/www/teqlif.com/venv/bin/uvicorn main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 4 \
    --loop uvloop \
    --proxy-headers \
    --forwarded-allow-ips 10.10.0.2
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536
OOMScoreAdj=-500
CPUWeight=200
IOWeight=200
TasksMax=512
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/teqlif.com

[Install]
WantedBy=multi-user.target
