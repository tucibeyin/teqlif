[Unit]
Description=MinIO Object Storage — Staging (node3)
After=network.target

[Service]
User=www-data
Group=www-data
EnvironmentFile=/var/www/teqlif.com/deploy/scale/resources/node3/.env.staging
ExecStart=/usr/local/bin/minio server /var/lib/minio --address :9010 --console-address :9011
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
