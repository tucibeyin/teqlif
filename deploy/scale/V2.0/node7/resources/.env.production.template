# node7 (Storage #1) — Production
# Deploy: cp .env.production.template /etc/teqlif/.env.production
# MinIO sistem değişkenleri (GOMEMLIMIT, MINIO_SERVER_URL vb.) systemd unit'te Environment= ile set edilir — bkz. §6.3

# === Guardian / Orchestrator ===
ORCH_REDIS_URL=redis://:<orch_redis_pass>@10.10.0.11:6380/0
GUARDIAN_REDIS_URL=redis://:<guardian_redis_pass>@10.10.0.11:6382/0
EDGE_NODE_ID=node7
DATA_DISK_PATH=/mnt/data

# === MinIO ===
MINIO_VOLUMES=/mnt/data/minio
MINIO_ROOT_USER=<minio_root_user>
MINIO_ROOT_PASSWORD=<minio_root_password>
