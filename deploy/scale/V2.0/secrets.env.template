# teqlif V2.0 — Secrets Dosyası
# ─────────────────────────────────────────────────────────────────────────────
# KULLANIM:
#   cp secrets.env.template secrets.env
#   chmod 600 secrets.env
#   # Aşağıdaki değerleri doldur (bölüm açıklamalarına bak)
#   # secrets.env .gitignore'da — repoya GİRMEZ
#
# BOOTSTRAP:
#   scp secrets.env root@<node>:/tmp/teqlif-secrets.env
#   ssh root@<node> "SECRETS_FILE=/tmp/teqlif-secrets.env bash bootstrap_nodeX.sh"
#   # Bootstrap bittikten sonra /tmp/teqlif-secrets.env otomatik silinir
#
# GÜNCELLEME: secrets.env.template Claude tarafından güncellenir (yeni servis
#   eklenince). secrets.env dosyanda eksik satır varsa template'ten ekle.
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# BÖLÜM 1 — Otomatik Üretilebilir (openssl rand)
# Her biri için: openssl rand -hex 32  (16 için: openssl rand -hex 16)
# ══════════════════════════════════════════════════════════════════════════════

# ── Veritabanı ────────────────────────────────────────────────────────────────
# Kullanım: node5, node6, node9 — PostgreSQL + PgBouncer + pg_backup
teqlif_db_password=

# Kullanım: node5 — PostgreSQL streaming replication (node6 + node9 WAL)
replicator_password=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Kullanım: Tüm 11 node — redis-core :6379 (uygulama cache, ARQ)
core_redis_pass=

# Kullanım: Tüm 11 node — redis-orch :6380 (orchestrator routing state)
orch_redis_pass=

# Kullanım: Tüm 11 node — redis-guardian :6382 (guardian job checkpoint)
guardian_redis_pass=

# ── ClickHouse ────────────────────────────────────────────────────────────────
# Kullanım: node5, node6 (yazma), node9 (depolama + backup)
teqlif_ch_password=

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Kullanım: node5, node6 — prod JWT imzası
secret_key=

# Kullanım: node3 — staging JWT imzası (prod'dan FARKLI olmalı)
staging_secret_key=

# ── Staging Veritabanı + Cache ────────────────────────────────────────────────
# Kullanım: node3 — lokal PostgreSQL staging şifresi
staging_pg_pass=

# Kullanım: node3 — lokal Redis staging şifresi
staging_redis_pass=

# ── MinIO — Prod ──────────────────────────────────────────────────────────────
# Kullanım: node7, node8 (sunucu), node5, node6, node9 (istemci)
# openssl rand -hex 16  (kullanıcı adı için kısa)
minio_root_user=

# openssl rand -hex 32
minio_root_password=

# ── MinIO — Staging ───────────────────────────────────────────────────────────
# Kullanım: node3 lokal MinIO staging (prod'dan izole)
minio_staging_root_user=

minio_staging_root_password=

# ── LiveKit — Staging ─────────────────────────────────────────────────────────
# Kullanım: node3 lokal LiveKit staging (prod'dan izole)
livekit_staging_api_key=

livekit_staging_api_secret=

# ── AI Proxy ──────────────────────────────────────────────────────────────────
# Kullanım: node2 (primary), node3 (warm standby), node5 (cold fallback), node6
ai_proxy_internal_token=

# ── Keepalived ────────────────────────────────────────────────────────────────
# Kullanım: node5, node6 — VRRP authentication şifresi
keepalived_pass=


# ══════════════════════════════════════════════════════════════════════════════
# BÖLÜM 2 — Harici Servis Credential'ları (Panelden Al)
# ══════════════════════════════════════════════════════════════════════════════

# ── LiveKit Cloud (live1/live2 prod) ─────────────────────────────────────────
# https://cloud.livekit.io → Project → API Keys
livekit_api_key=

livekit_api_secret=

# ── Brevo (e-posta) ───────────────────────────────────────────────────────────
# https://app.brevo.com → SMTP & API → API Keys
brevo_api_key=

# ── Apple Push Notification (APNS) ───────────────────────────────────────────
# https://developer.apple.com → Certificates → Keys → AuthKey_*.p8
# Key ID (8 karakter): örn. ABC1234567
apns_key_id=

# Team ID (10 karakter): örn. ABCDE12345
apns_team_id=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
google_client_id=

# ── Groq (AI proxy) ───────────────────────────────────────────────────────────
# https://console.groq.com → API Keys
groq_api_key=

# ── Google Gemini (AI proxy) ──────────────────────────────────────────────────
# https://aistudio.google.com → Get API key
gemini_api_key=

# ── Sentry ────────────────────────────────────────────────────────────────────
# https://sentry.io → Project → Settings → Client Keys → DSN
sentry_backend_dsn=

sentry_backend_dsn_staging=

# ── Telegram (Alertmanager + Guardian bildirimleri) ───────────────────────────
# @BotFather → /newbot → token
telegram_bot_token=

# Kanal/grup ID: @userinfobot ile öğren (sayı, - ile başlayabilir)
telegram_chat_id=

# Alerts kanalı (ops kanalından farklıysa, aynıysa telegram_chat_id değerini tekrar gir)
telegram_chat_id_alerts=

# ── Cloudflare Turnstile (CAPTCHA) ────────────────────────────────────────────
# https://dash.cloudflare.com → Turnstile → Site → Secret Key
captcha_secret_key=

# ── Admin Kullanıcısı ─────────────────────────────────────────────────────────
# Uygulama admin paneli için
admin_email=

# bcrypt hash: python3 -c "import bcrypt; print(bcrypt.hashpw(b'SIFRE', bcrypt.gensalt()).decode())"
admin_password_hash=


# ══════════════════════════════════════════════════════════════════════════════
