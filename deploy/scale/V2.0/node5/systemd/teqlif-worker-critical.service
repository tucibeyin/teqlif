[Unit]
Description=Teqlif ARQ Worker (Critical)
After=redis-core.service pgbouncer.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/etc/teqlif/.env.production
ExecStart=/var/www/teqlif.com/.venv/bin/python3 -m arq app.worker.CriticalWorkerSettings
Restart=always
RestartSec=10
LimitNOFILE=65535
MemoryMax=800M
StandardOutput=append:/var/log/teqlif/worker/arq-critical.log
StandardError=append:/var/log/teqlif/worker/arq-critical-error.log

[Install]
WantedBy=multi-user.target
