[Unit]
Description=Teqlif ARQ Worker Critical (Staging)
After=network.target redis-staging.service teqlif-staging.service
BindsTo=teqlif-staging.service
PartOf=teqlif-staging.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/etc/teqlif/.env.staging
ExecStart=/var/www/teqlif.com/.venv/bin/python3 -m arq app.worker.CriticalWorkerSettings
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
