[Unit]
Description=Teqlif MinIO Cold Archive Backup
After=network.target
ConditionPathExists=/opt/teqlif/scripts/minio_backup.sh

[Service]
Type=oneshot
User=tucibeyin
EnvironmentFile=/etc/teqlif/.env.production
ExecStart=/opt/teqlif/scripts/minio_backup.sh
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
