[Unit]
Description=Teqlif AI Proxy — node2 (US IP, Gemini + Groq)
After=network.target

[Service]
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/var/www/teqlif.com/deploy/scale/resources/.env.node2.production
ExecStart=/var/www/teqlif.com/venv/bin/uvicorn app.ai_proxy_main:app \
    --host 10.10.0.3 \
    --port 8080 \
    --workers 1 \
    --loop uvloop
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
