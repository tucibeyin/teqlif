[Unit]
Description=Cloudflare DNS Failover Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/cf-failover.env
ExecStart=/usr/local/bin/cf-failover.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
