[Unit]
Description=Teqlif Background Worker
After=network.target redis.service

[Service]
User=tucibeyin
Group=tucibeyin
WorkingDirectory=/var/www/teqlif.com/backend
EnvironmentFile=/var/www/teqlif.com/deploy/scale/resources/.env.node1.production
ExecStart=/var/www/teqlif.com/venv/bin/python -m worker
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
